# Supabase project credentials — copy this file to .env and fill in your own values.
# Project URL and anon/publishable key: Supabase Dashboard → Settings → API.
# Without these the app throws at startup.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
